# Copy to .env.local and fill in. Vite only exposes VITE_* to the browser.

# Lead capture -> orchestration DB / console admin view.
# Leave blank to fall back to email-only delivery.
VITE_LEADS_API_URL=
VITE_LEADS_API_KEY=

# Server-only. Mail From is always noreply@snapserve.ai. Do not prefix with VITE_.
# In Brevo, verify the sender / domain for noreply@snapserve.ai.
BREVO_API_KEY=

# Analytics
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
